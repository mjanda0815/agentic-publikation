flowchart TB
    subgraph P1["Statische Prüfungen"]
        direction LR
        S1["Syntax<br/><i>mvn compile</i>"] --> S2["Style<br/><i>Checkstyle</i>"]
        S2 --> S3["Security<br/><i>SpotBugs / OWASP</i>"]
    end
    subgraph P2["Fachliche Prüfungen"]
        direction LR
        S4["Domain<br/><i>Bounded Context</i>"] --> S5["Tests<br/><i>JUnit + Coverage</i>"]
        S5 --> S6["AI Risk Score<br/><i>Claim Verification</i>"]
    end
    OK["Commit erlaubt"]
    FB["Bei Fehler: Agent korrigiert automatisch<br/>oder eskaliert an Review-Agent"]
    PRE["PreToolUse-Hook"] -.-> P1
    P1 --> P2
    POST["PostToolUse-Hook"] -.-> P2
    P2 --> OK
    P2 -. "FAIL" .-> FB
    classDef sec fill:#f8dddd,stroke:#333333
    classDef ok fill:#ddeedd,stroke:#333333
    classDef hook fill:#eeeeee,stroke:#333333
    class S3,FB sec
    class OK ok
    class PRE,POST hook
